{
  "id": "/staff",
  "name": "RYST Harbour",
  "short_name": "RYST Harbour",
  "description": "Villa operations in one place: bookings, guest check-ins, checklists, food orders, petty cash and inventory.",
  "start_url": "/login.html?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F6F3ED",
  "theme_color": "#F6F3ED",
  "icons": [
    {
      "src": "/assets/staff-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/staff-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/staff-icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New booking",
      "short_name": "New booking",
      "url": "/stay.html",
      "icons": [
        {
          "src": "/assets/shortcut-booking-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/assets/shortcut-booking-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "/bookings.html",
      "icons": [
        {
          "src": "/assets/shortcut-calendar-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/assets/shortcut-calendar-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Report an issue",
      "short_name": "Report issue",
      "url": "/issues.html#report",
      "icons": [
        {
          "src": "/assets/shortcut-issue-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/assets/shortcut-issue-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add expense",
      "short_name": "Add expense",
      "url": "/petty-cash.html#add",
      "icons": [
        {
          "src": "/assets/shortcut-expense-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/assets/shortcut-expense-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-receipt",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
